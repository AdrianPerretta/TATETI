`timescale 1 ps/ 1 ps
module teclado_test_2_vlg_sample_tst(
	clk,
	R1,
	R2,
	R3,
	R4,
	sampler_tx
);
input  clk;
input  R1;
input  R2;
input  R3;
input  R4;
output sampler_tx;

reg sample;
time current_time;
always @(clk or R1 or R2 or R3 or R4)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

