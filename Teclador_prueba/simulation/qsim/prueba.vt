wire t12;
wire t13;
wire t14;
wire t15;
wire t16;

wire sampler;                             

// assign statements (if any)                          
teclado_test_2 i1 (
// port map - connection between master ports and signals/registers   
	.C1(C1),
	.C2(C2),
	.C3(C3),
	.C4(C4),
	.clk(clk),
	.R1(R1),
	.R2(R2),
	.R3(R3),
	.R4(R4),
	.t1(t1),
	.t2(t2),
	.t3(t3),
	.t4(t4),
	.t5(t5),
	.t6(t6),
	.t7(t7),
	.t8(t8),
	.t9(t9),
	.t10(t10),
	.t11(t11),
	.t12(t12),
	.t13(t13),
	.t14(t14),
	.t15(t15),
	.t16(t16)
);

// clk
initial
begin
	repeat(99)
	begin
		clk = 1'b0;
		clk = #5000 1'b1;
		# 5000;
	end
	clk = 1'b0;
end 

// R1
initial
begin
	R1 = 1'b0;
	R1 = #110000 1'b1;
	R1 = #200000 1'b0;
end 

// R2
initial
begin
	R2 = 1'b0;
	R2 = #340000 1'b1;
	R2 = #190000 1'b0;
end 

// R3
initial
begin
	R3 = 1'b0;
	R3 = #560000 1'b1;
	R3 = #150000 1'b0;
end 

// R4
initial
begin
	R4 = 1'b0;
	R4 = #730000 1'b1;
	R4 = #160000 1'b0;
end 

teclado_test_2_vlg_sample_tst tb_sample (
	.clk(clk),
	.R1(R1),
	.R2(R2),
	.R3(R3),
	.R4(R4),
	.sampler_tx(sampler)
);

teclado_test_2_vlg_check_tst tb_out(
	.C1(C1),
	.C2(C2),
	.C3(C3),
	.C4(C4),
	.t1(t1),
	.t2(t2),
	.t3(t3),
	.t4(t4),
	.t5(t5),
	.t6(t6),
	.t7(t7),
	.t8(t8),
	.t9(t9),
	.t10(t10),
	.t11(t11),
	.t12(t12),
	.t13(t13),
	.t14(t14),
	.t15(t15),
	.t16(t16),
	.sampler_rx(sampler)
);
endmodule

