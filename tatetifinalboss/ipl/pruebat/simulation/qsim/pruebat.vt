`timescale 1 ps/ 1 ps
module pruebat_vlg_sample_tst(
	clk,
	sampler_tx
);
input  clk;
output sampler_tx;

reg sample;
time current_time;
always @(clk)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module pruebat_vlg_check_tst (
	J1vJ2,
	J1vM,
	reset,
	sc1,
	sc2,
	tablero_juego,
	sampler_rx
);
input  J1vJ2;
input  J1vM;
input  reset;
input [2:0] sc1;
input [2:0] sc2;
input [3:0] tablero_juego;
input sampler_rx;

reg  J1vJ2_expected;
reg  J1vM_expected;
reg  reset_expected;
reg [2:0] sc1_expected;
reg [2:0] sc2_expected;
reg [3:0] tablero_juego_expected;

reg  J1vJ2_prev;
reg  J1vM_prev;
reg  reset_prev;
reg [2:0] sc1_prev;
reg [2:0] sc2_prev;
reg [3:0] tablero_juego_prev;

reg  J1vJ2_expected_prev;
reg  J1vM_expected_prev;
reg  reset_expected_prev;
reg [2:0] sc1_expected_prev;
reg [2:0] sc2_expected_prev;
reg [3:0] tablero_juego_expected_prev;

reg  last_J1vJ2_exp;
reg  last_J1vM_exp;
reg  last_reset_exp;
reg [2:0] last_sc1_exp;
reg [2:0] last_sc2_exp;
reg [3:0] last_tablero_juego_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:6] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 6'b1;
end

// update real /o prevs

always @(trigger)
begin
	J1vJ2_prev = J1vJ2;
	J1vM_prev = J1vM;
	reset_prev = reset;
	sc1_prev = sc1;
	sc2_prev = sc2;
	tablero_juego_prev = tablero_juego;
end

// update expected /o prevs

always @(trigger)
begin
	J1vJ2_expected_prev = J1vJ2_expected;
	J1vM_expected_prev = J1vM_expected;
	reset_expected_prev = reset_expected;
	sc1_expected_prev = sc1_expected;
	sc2_expected_prev = sc2_expected;
	tablero_juego_expected_prev = tablero_juego_expected;
end



// expected J1vJ2
initial
begin
	J1vJ2_expected = 1'bX;
end 

// expected J1vM
initial
begin
	J1vM_expected = 1'bX;
end 

// expected reset
initial
begin
	reset_expected = 1'bX;
end 
// expected sc1[ 2 ]
initial
begin
	sc1_expected[2] = 1'bX;
end 
// expected sc1[ 1 ]
initial
begin
	sc1_expected[1] = 1'bX;
end 
// expected sc1[ 0 ]
initial
begin
	sc1_expected[0] = 1'bX;
end 
// expected sc2[ 2 ]
initial
begin
	sc2_expected[2] = 1'bX;
end 
// expected sc2[ 1 ]
initial
begin
	sc2_expected[1] = 1'bX;
end 
// expected sc2[ 0 ]
initial
begin
	sc2_expected[0] = 1'bX;
end 
// expected tablero_juego[ 3 ]
initial
begin
	tablero_juego_expected[3] = 1'bX;
end 
// expected tablero_juego[ 2 ]
initial
begin
	tablero_juego_expected[2] = 1'bX;
end 
// expected tablero_juego[ 1 ]
initial
begin
	tablero_juego_expected[1] = 1'bX;
end 
// expected tablero_juego[ 0 ]
initial
begin
	tablero_juego_expected[0] = 1'bX;
end 
// generate trigger
always @(J1vJ2_expected or J1vJ2 or J1vM_expected or J1vM or reset_expected or reset or sc1_expected or sc1 or sc2_expected or sc2 or tablero_juego_expected or tablero_juego)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected J1vJ2 = %b | expected J1vM = %b | expected reset = %b | expected sc1 = %b | expected sc2 = %b | expected tablero_juego = %b | ",J1vJ2_expected_prev,J1vM_expected_prev,reset_expected_prev,sc1_expected_prev,sc2_expected_prev,tablero_juego_expected_prev);
	$display("| real J1vJ2 = %b | real J1vM = %b | real reset = %b | real sc1 = %b | real sc2 = %b | real tablero_juego = %b | ",J1vJ2_prev,J1vM_prev,reset_prev,sc1_prev,sc2_prev,tablero_juego_prev);
`endif
	if (
		( J1vJ2_expected_prev !== 1'bx ) && ( J1vJ2_prev !== J1vJ2_expected_prev )
		&& ((J1vJ2_expected_prev !== last_J1vJ2_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port J1vJ2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", J1vJ2_expected_prev);
		$display ("     Real value = %b", J1vJ2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_J1vJ2_exp = J1vJ2_expected_prev;
	end
	if (
		( J1vM_expected_prev !== 1'bx ) && ( J1vM_prev !== J1vM_expected_prev )
		&& ((J1vM_expected_prev !== last_J1vM_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port J1vM :: @time = %t",  $realtime);
		$display ("     Expected value = %b", J1vM_expected_prev);
		$display ("     Real value = %b", J1vM_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_J1vM_exp = J1vM_expected_prev;
	end
	if (
		( reset_expected_prev !== 1'bx ) && ( reset_prev !== reset_expected_prev )
		&& ((reset_expected_prev !== last_reset_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port reset :: @time = %t",  $realtime);
		$display ("     Expected value = %b", reset_expected_prev);
		$display ("     Real value = %b", reset_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_reset_exp = reset_expected_prev;
	end
	if (
		( sc1_expected_prev[0] !== 1'bx ) && ( sc1_prev[0] !== sc1_expected_prev[0] )
		&& ((sc1_expected_prev[0] !== last_sc1_exp[0]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port sc1[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", sc1_expected_prev);
		$display ("     Real value = %b", sc1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_sc1_exp[0] = sc1_expected_prev[0];
	end
	if (
		( sc1_expected_prev[1] !== 1'bx ) && ( sc1_prev[1] !== sc1_expected_prev[1] )
		&& ((sc1_expected_prev[1] !== last_sc1_exp[1]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port sc1[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", sc1_expected_prev);
		$display ("     Real value = %b", sc1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_sc1_exp[1] = sc1_expected_prev[1];
	end
	if (
		( sc1_expected_prev[2] !== 1'bx ) && ( sc1_prev[2] !== sc1_expected_prev[2] )
		&& ((sc1_expected_prev[2] !== last_sc1_exp[2]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port sc1[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", sc1_expected_prev);
		$display ("     Real value = %b", sc1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_sc1_exp[2] = sc1_expected_prev[2];
	end
	if (
		( sc2_expected_prev[0] !== 1'bx ) && ( sc2_prev[0] !== sc2_expected_prev[0] )
		&& ((sc2_expected_prev[0] !== last_sc2_exp[0]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port sc2[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", sc2_expected_prev);
		$display ("     Real value = %b", sc2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_sc2_exp[0] = sc2_expected_prev[0];
	end
	if (
		( sc2_expected_prev[1] !== 1'bx ) && ( sc2_prev[1] !== sc2_expected_prev[1] )
		&& ((sc2_expected_prev[1] !== last_sc2_exp[1]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port sc2[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", sc2_expected_prev);
		$display ("     Real value = %b", sc2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_sc2_exp[1] = sc2_expected_prev[1];
	end
	if (
		( sc2_expected_prev[2] !== 1'bx ) && ( sc2_prev[2] !== sc2_expected_prev[2] )
		&& ((sc2_expected_prev[2] !== last_sc2_exp[2]) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port sc2[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", sc2_expected_prev);
		$display ("     Real value = %b", sc2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_sc2_exp[2] = sc2_expected_prev[2];
	end
	if (
		( tablero_juego_expected_prev[0] !== 1'bx ) && ( tablero_juego_prev[0] !== tablero_juego_expected_prev[0] )
		&& ((tablero_juego_expected_prev[0] !== last_tablero_juego_exp[0]) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port tablero_juego[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", tablero_juego_expected_prev);
		$display ("     Real value = %b", tablero_juego_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_tablero_juego_exp[0] = tablero_juego_expected_prev[0];
	end
	if (
		( tablero_juego_expected_prev[1] !== 1'bx ) && ( tablero_juego_prev[1] !== tablero_juego_expected_prev[1] )
		&& ((tablero_juego_expected_prev[1] !== last_tablero_juego_exp[1]) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port tablero_juego[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", tablero_juego_expected_prev);
		$display ("     Real value = %b", tablero_juego_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_tablero_juego_exp[1] = tablero_juego_expected_prev[1];
	end
	if (
		( tablero_juego_expected_prev[2] !== 1'bx ) && ( tablero_juego_prev[2] !== tablero_juego_expected_prev[2] )
		&& ((tablero_juego_expected_prev[2] !== last_tablero_juego_exp[2]) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port tablero_juego[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", tablero_juego_expected_prev);
		$display ("     Real value = %b", tablero_juego_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_tablero_juego_exp[2] = tablero_juego_expected_prev[2];
	end
	if (
		( tablero_juego_expected_prev[3] !== 1'bx ) && ( tablero_juego_prev[3] !== tablero_juego_expected_prev[3] )
		&& ((tablero_juego_expected_prev[3] !== last_tablero_juego_exp[3]) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port tablero_juego[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", tablero_juego_expected_prev);
