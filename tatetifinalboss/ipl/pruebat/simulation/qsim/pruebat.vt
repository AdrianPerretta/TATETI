		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_tablero_juego_exp[3] = tablero_juego_expected_prev[3];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module pruebat_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
// wires                                               
wire J1vJ2;
wire J1vM;
wire reset;
wire [2:0] sc1;
wire [2:0] sc2;
wire [3:0] tablero_juego;

wire sampler;                             

// assign statements (if any)                          
pruebat i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.J1vJ2(J1vJ2),
	.J1vM(J1vM),
	.reset(reset),
	.sc1(sc1),
	.sc2(sc2),
	.tablero_juego(tablero_juego)
);

// clk
always
begin
	clk = 1'b0;
	clk = #10000 1'b1;
	#10000;
end 

pruebat_vlg_sample_tst tb_sample (
	.clk(clk),
	.sampler_tx(sampler)
);

pruebat_vlg_check_tst tb_out(
	.J1vJ2(J1vJ2),
	.J1vM(J1vM),
	.reset(reset),
	.sc1(sc1),
	.sc2(sc2),
	.tablero_juego(tablero_juego),
	.sampler_rx(sampler)
);
endmodule

