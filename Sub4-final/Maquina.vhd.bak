LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY Maquina IS
    PORT (
        reset : IN STD_LOGIC := '0';
        clock : IN STD_LOGIC;
        modo : IN STD_LOGIC := '0';
        movimiento_valido : IN STD_LOGIC := '0';
        victoria_j1 : IN STD_LOGIC := '0';
        victoria_j2 : IN STD_LOGIC := '0';
        empate : IN STD_LOGIC := '0';
        reiniciar : IN STD_LOGIC := '0'
    );
END Maquina;

ARCHITECTURE BEHAVIOR OF Maquina IS
    TYPE type_fstate IS (T_J2,FIN_J,LIMPIAR,T_M,T_J1,INICIO);
    SIGNAL fstate : type_fstate;
    SIGNAL reg_fstate : type_fstate;
BEGIN
    PROCESS (clock,reg_fstate)
    BEGIN
        IF (clock='1' AND clock'event) THEN
            fstate <= reg_fstate;
        END IF;
    END PROCESS;

    PROCESS (fstate,reset,modo,movimiento_valido,victoria_j1,victoria_j2,empate,reiniciar)
    BEGIN
        IF (reset='1') THEN
            reg_fstate <= INICIO;
        ELSE
            CASE fstate IS
                WHEN T_J2 =>
                    IF (((victoria_j2 = '1') OR (empate = '1'))) THEN
                        reg_fstate <= LIMPIAR;
                    ELSIF ((((movimiento_valido = '1') AND (victoria_j2 = '0')) AND (empate = '0'))) THEN
                        reg_fstate <= T_J1;
                    ELSIF ((((movimiento_valido = '0') AND (victoria_j2 = '0')) AND (empate = '0'))) THEN
                        reg_fstate <= T_J2;
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        reg_fstate <= T_J2;
                    END IF;
                WHEN FIN_J =>
                    reg_fstate <= INICIO;
                WHEN LIMPIAR =>
                    IF ((reiniciar = '1')) THEN
                        reg_fstate <= FIN_J;
                    ELSIF ((reiniciar = '0')) THEN
                        reg_fstate <= T_J1;
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        reg_fstate <= LIMPIAR;
                    END IF;
                WHEN T_M =>
                    IF (((victoria_j2 = '1') OR (empate = '1'))) THEN
                        reg_fstate <= LIMPIAR;
                    ELSIF ((((movimiento_valido = '1') AND (victoria_j2 = '0')) AND (empate = '0'))) THEN
                        reg_fstate <= T_J1;
                    ELSIF ((((movimiento_valido = '0') AND (victoria_j2 = '0')) AND (empate = '0'))) THEN
                        reg_fstate <= T_M;
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        reg_fstate <= T_M;
                    END IF;
                WHEN T_J1 =>
                    IF (((victoria_j1 = '1') OR (empate = '1'))) THEN
                        reg_fstate <= LIMPIAR;
                    ELSIF (((((movimiento_valido = '1') AND (modo = '0')) AND (victoria_j1 = '0')) AND (empate = '0'))) THEN
                        reg_fstate <= T_J2;
                    ELSIF (((((movimiento_valido = '1') AND (modo = '1')) AND (victoria_j1 = '0')) AND (empate = '0'))) THEN
                        reg_fstate <= T_M;
                    ELSIF ((((movimiento_valido = '0') AND (victoria_j1 = '0')) AND (empate = '0'))) THEN
                        reg_fstate <= T_J1;
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        reg_fstate <= T_J1;
                    END IF;
                WHEN INICIO =>
                    IF ((modo = '1')) THEN
                        reg_fstate <= T_J1;
                    -- Inserting 'else' block to prevent latch inference
                    ELSE
                        reg_fstate <= INICIO;
                    END IF;
                WHEN OTHERS => 
                    report "Reach undefined state";
            END CASE;
        END IF;
    END PROCESS;
END BEHAVIOR;
